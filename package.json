{
  "name": "react-mindee-js",
  "version": "1.7.0",
  "description": "Front-End Computer Vision SDK for React",
  "author": "@mindee",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mindee/react-mindee-js.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@12.8.1",
  "dependencies": {
    "heic2any": "^0.0.4",
    "konva": "^10.7.0",
    "pdfjs-dist": "^6.3.289",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@j178/prek": "^0.5.4",
    "@microsoft/api-extractor": "^7.59.3",
    "@simonsmith/cypress-image-snapshot": "^11.0.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/utif": "^3.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "cypress": "^16.1.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite build --watch",
    "cy:prepare": "pnpm build",
    "build": "vite build",
    "cy:open": "cypress open --component --browser chrome",
    "cy:run": "cypress run --component --browser chrome --spec 'src/**/*.spec.{ts,tsx}'",
    "cy:run:integration": "cypress run --component --browser chrome --spec 'cypress/integration/**/*.spec.{ts,tsx}'",
    "docs:start": "pnpm --dir ./docs start",
    "docs:install": "pnpm --dir ./docs install",
    "docs:prepare": "pnpm build && pnpm docs:install",
    "docs:update": "pnpm --dir ./docs add ../",
    "docs:build": "pnpm --dir ./docs build",
    "docs:deploy": "pnpm --dir ./docs deploy",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "lint": "tsc --noEmit && eslint --max-warnings 0 . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write ."
  },
  "keywords": [
    "react",
    "js",
    "javascript",
    "mindee",
    "SDK",
    "canvas",
    "document",
    "image",
    "segmentation",
    "processing",
    "computer",
    "vision"
  ]
}
